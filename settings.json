{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[solidity]": {
    "editor.defaultFormatter": "NomicFoundation.hardhat-solidity"
  },
  "solidity.compileUsingRemoteVersion": "v0.8.24",
  "files.associations": {
    "*.sol": "solidity"
  },
  "editor.rulers": [100],
  "editor.tabSize": 2
}