# ═══════════════════════════════════════════════════════════════
# Rongai Blockchain Land Registry — FRONTEND Environment Variables
# ⚠  NEVER commit this file to Git.
# ⚠  Only VITE_ prefixed variables are exposed to the browser
# ═══════════════════════════════════════════════════════════════

# ── Network (switch between localhost and sepolia) ───────────────
# Change to "sepolia" after deploying to testnet
VITE_NETWORK=localhost

# ── Contract Addresses — Hardhat Localhost (chain-31337) ─────────
# These are your CURRENT localhost addresses — keep until Sepolia deploy
VITE_LAND_PARCEL=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
VITE_LAND_REGISTRY=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9
VITE_LAND_TRANSFER=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
VITE_LANDHOLDER_IDENTITY=0x0165878A594ca255338adfa4d48449f69242Eb8F
VITE_STAMP_DUTY=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853
VITE_TITLE_DEED=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6

# ── Contract Addresses — Sepolia Testnet (chain-11155111) ────────
# Leave blank for now — fill after running: npx hardhat run scripts/deploy.js --network sepolia
VITE_SEPOLIA_LAND_PARCEL=
VITE_SEPOLIA_LAND_REGISTRY=
VITE_SEPOLIA_LAND_TRANSFER=
VITE_SEPOLIA_LANDHOLDER_IDENTITY=
VITE_SEPOLIA_STAMP_DUTY=
VITE_SEPOLIA_TITLE_DEED=

# ── Pinata IPFS ──────────────────────────────────────────────────
VITE_PINATA_JWT=paste_your_pinata_jwt_here